{
  "info": {
    "name": "CODSOFT Task 3 - To-Do List REST API",
    "description": "Postman Collection for CodSoft Backend Development Internship Task 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yaswanth Bose\",\n  \"email\": \"yaswanth@codsoft.dev\",\n  \"password\": \"password123\"\n}"
            },
            "url": "http://localhost:3003/api/auth/register"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yaswanth@codsoft.dev\",\n  \"password\": \"password123\"\n}"
            },
            "url": "http://localhost:3003/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "url": "http://localhost:3003/api/tasks?priority=urgent"
          }
        },
        {
          "name": "Get Task Stats Summary",
          "request": {
            "method": "GET",
            "url": "http://localhost:3003/api/tasks/summary"
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Submit CodSoft Internship Tasks\",\n  \"description\": \"Push repositories and submit Google Form\",\n  \"priority\": \"urgent\",\n  \"category\": \"work\",\n  \"due_date\": \"2026-10-15\"\n}"
            },
            "url": "http://localhost:3003/api/tasks"
          }
        },
        {
          "name": "Toggle Task Complete/Pending",
          "request": {
            "method": "PATCH",
            "url": "http://localhost:3003/api/tasks/1/toggle"
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3003/api/tasks/1"
          }
        }
      ]
    }
  ]
}
